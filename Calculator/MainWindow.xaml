<Window x:Class="CalculatorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="400" Width="300">
    <Grid>
        <TextBox Name="Display" FontSize="24" Height="50" Margin="10" VerticalAlignment="Top" Text="0"/>

        <Grid Margin="10,70,10,10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Цифры -->
            <Button Content="7" Click="Number_Click" Grid.Row="0" Grid.Column="0"/>
            <Button Content="8" Click="Number_Click" Grid.Row="0" Grid.Column="1"/>
            <Button Content="9" Click="Number_Click" Grid.Row="0" Grid.Column="2"/>
            <Button Content="/" Click="Expression_Click" Grid.Row="0" Grid.Column="3"/>

            <Button Content="4" Click="Number_Click" Grid.Row="1" Grid.Column="0"/>
            <Button Content="5" Click="Number_Click" Grid.Row="1" Grid.Column="1"/>
            <Button Content="6" Click="Number_Click" Grid.Row="1" Grid.Column="2"/>
            <Button Content="*" Click="Expression_Click" Grid.Row="1" Grid.Column="3"/>

            <Button Content="1" Click="Number_Click" Grid.Row="2" Grid.Column="0"/>
            <Button Content="2" Click="Number_Click" Grid.Row="2" Grid.Column="1"/>
            <Button Content="3" Click="Number_Click" Grid.Row="2" Grid.Column="2"/>
            <Button Content="-" Click="Expression_Click" Grid.Row="2" Grid.Column="3"/>

            <Button Content="0" Click="Number_Click" Grid.Row="3" Grid.Column="0"/>
            <Button Content="=" Click="Equals_Click" Grid.Row="3" Grid.Column="1"/>
            <Button Content="+" Click="Expression_Click" Grid.Row="3" Grid.Column="2"/>
            <Button Content="C" Click="Clear_Click" Grid.Row="3" Grid.Column="3"/>

            <!-- Доп функции -->
            <Button Content="√" Click="Sqrt_Click" Grid.Row="4" Grid.Column="0"/>
            <Button Content="sin" Click="Sin_Click" Grid.Row="4" Grid.Column="1"/>
            <Button Content="cos" Click="Cos_Click" Grid.Row="4" Grid.Column="2"/>
            <Button Content="tg" Click="Tan_Click" Grid.Row="4" Grid.Column="3"/>
            <Button Content="(" Click="Number_Click" Grid.Row="4" Grid.Column="0"/>
            <Button Content=")" Click="Number_Click" Grid.Row="4" Grid.Column="1"/>
            <StackPanel Orientation="Horizontal" Margin="10,55,10,0">
                <RadioButton Content="DEG" Name="DegMode" IsChecked="True"/>
                <RadioButton Content="RAD" Name="RadMode"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
